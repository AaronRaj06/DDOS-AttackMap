# Copy to backend/.env (gitignored). Never put real values in this file.
# Everything is optional: without keys the app runs in a labeled demo mode.

# My Profile > API Tokens > Create custom token > Account > Radar > Read
CLOUDFLARE_API_TOKEN=
# https://www.abuseipdb.com/account/api
ABUSEIPDB_KEY=
# Replayed events are stored for 3 days when set
MONGODB_URI=

# 5050 because macOS AirPlay holds 5000
PORT=5050
HOST=127.0.0.1
# Extra browser origins allowed to open the WebSocket (comma separated)
ALLOWED_ORIGINS=
# Number of reverse proxies in front of the app
TRUST_PROXY=0
