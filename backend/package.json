{
  "name": "ddos-attack-backend",
  "version": "1.0.0",
  "description": "DoS attack map backend: Cloudflare Radar trends, AbuseIPDB threat points and an IP classifier",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "dev": "node --watch --env-file-if-exists=.env index.js",
    "test": "node --test test/*.test.js",
    "geo:update": "node scripts/updateGeo.js",
    "ml:collect": "node --env-file-if-exists=.env scripts/collect.js",
    "ml:train": "node scripts/train.js",
    "spikes:simulate": "node scripts/simulateSpikes.js",
    "alert:test": "node --env-file-if-exists=.env scripts/alertTest.js"
  },
  "keywords": [
    "ddos",
    "websocket",
    "security",
    "threat-intelligence"
  ],
  "dependencies": {
    "csv-writer": "^1.6.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "maxmind": "^5.0.8",
    "mongoose": "^9.12.0",
    "ws": "^8.22.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
